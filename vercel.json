{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": { "root": "frontend/" },
    "payments": { "root": "./", "entrypoint": "app.main:app" }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "payments" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
